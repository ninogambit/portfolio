void clearBuffer() { 
  memset(buffer, 0x00, sizeof(buffer)); // Fills a block of memory with a single byte value
}

void drawBitmap(const uint8_t *bitmap) {
  for (uint16_t i = 0; i < 1024; i++) {
    uint8_t byte = pgm_read_byte(&bitmap[i]);
    buffer[i] = byte;  // copy directly to framebuffer
  }
  updateDisplay();
}

void drawPixel(uint8_t x, uint8_t y, bool on) {
  if (x >= 128 || y >= 64) return;
  uint16_t index = x + (y / 8) * 128;
  uint8_t mask = 1 << (y & 7); // Shift (remainder modulo 8) positions to the left 
  if (on)
    buffer[index] |= mask;
  else
    buffer[index] &= ~mask;
}

