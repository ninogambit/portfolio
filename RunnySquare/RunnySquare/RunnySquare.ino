void drawRect(uint8_t x, uint8_t y, uint8_t w, uint8_t h, bool on) {
  if (x >= SCREEN_WIDTH || y >= SCREEN_HEIGHT || w == 0 || h == 0) return;
  // Clip to screen bounds
  if (x + w > SCREEN_WIDTH) w = SCREEN_WIDTH - x;
  if (y + h > SCREEN_HEIGHT) h = SCREEN_HEIGHT - y;

  uint8_t start_page = y / 8;
  uint8_t end_page = (y + h - 1) / 8;
  uint8_t start_mask = 0xFF << (y % 8);
  uint8_t end_mask = (1 << ((y + h - 1) % 8 + 1)) - 1;

  for (uint8_t col = x; col < x + w; col++) {
    for (uint8_t page = start_page; page <= end_page; page++) {
      uint16_t idx = col + page * SCREEN_WIDTH;
      uint8_t mask;
      if (page == start_page && page == end_page) {
        mask = start_mask & end_mask;
      } else if (page == start_page) {
        mask = start_mask;
      } else if (page == end_page) {
        mask = end_mask;
      } else {
        mask = 0xFF;
      }
      if (on) {
        buffer[idx] |= mask;
      } else {
        buffer[idx] &= ~mask;
      }
    }
  }
}

void drawChar(uint8_t x, uint8_t y, char c, bool on) {
  if (c < 32 || c > 90) return; // only basic ASCII
  uint16_t index = (c - 32) * 5;
  for (uint8_t col = 0; col < 5; col++) {
    uint8_t line = pgm_read_byte(&textFont[index + col]);
    for (uint8_t row = 0; row < 8; row++) {
      if (line & (1 << row)) {
       drawPixel(x + col, y + row, on);
      }
    }
  }
}

void drawText(uint8_t x, uint8_t y, const char* str, bool on) {
  while (*str) {
    drawChar(x, y, *str++, on);
    x += 6;  // 5 pixels + 1 spacing
  }
}

void updateDisplay() {
  sendDisplayCommand(0x21); // set column address
  sendDisplayCommand(0); // start column
  sendDisplayCommand(127); // end column
  sendDisplayCommand(0x22); // set page address
  sendDisplayCommand(0); // start page
  sendDisplayCommand(7); // end page

  uint16_t i = 0;
  while (i < 1024) {
    Wire.beginTransmission(SSD1306_ADDR);
    Wire.write(0x40); // Control byte: Co = 0; D/C# = 1 : b01000000
    uint8_t count = 0;
    while (count < 31 && i < 1024) { //. Max 31 data bytes per transmission
      Wire.write(buffer[i]);
      i++;
      count++;
    }
    Wire.endTransmission();
  }

}

void sendDisplayCommand(uint8_t cmd) {
  Wire.beginTransmission(SSD1306_ADDR);
  Wire.write(0x00); // Control byte: Co = 0; D/C# = 0
  Wire.write(cmd);
  Wire.endTransmission();
}

void sendDisplayData(uint8_t data) {
  Wire.beginTransmission(SSD1306_ADDR);
  Wire.write(0x40);  // Control byte: Co = 0; D/C# = 1 : b01000000
  Wire.write(data);
  Wire.endTransmission();
}

void initDisplay() {
  delay(100);
  sendDisplayCommand(0xAE);
  sendDisplayCommand(0xD5); sendDisplayCommand(0x80); // Set display clock divide ratio/osciallatior frequency +
  sendDisplayCommand(0xA8); sendDisplayCommand(0x3F); // Multiplex ratio (1 to 64), 64 MUX for 128x64 +
  sendDisplayCommand(0xD3); sendDisplayCommand(0x00); // Display offset, no offset + 
  sendDisplayCommand(0x40); // Start line at 0 +
  sendDisplayCommand(0x8D); sendDisplayCommand(0x14); // Charge pump setting, Enable charge pump +
  sendDisplayCommand(0x20); sendDisplayCommand(0x00); // Set memory addressing mode, horizontal +
  sendDisplayCommand(0xA1); // Segment remap (column address 127 is mapped to SEG0) (flip horizontally) +
  sendDisplayCommand(0xC8); // COM output scan direction remapped (flip vertically) +
  sendDisplayCommand(0xDA); sendDisplayCommand(0x12); // COM pins hardware config, default for 128x64 +
  sendDisplayCommand(0x81); sendDisplayCommand(0x7F); // Contrast control, cotnrast value( adjust 0x00-0xFF for brightness) +
  sendDisplayCommand(0xD9); sendDisplayCommand(0xF1); // Pre-charge period +
  sendDisplayCommand(0xDB); sendDisplayCommand(0x40); // VCOMH deselect level +
  sendDisplayCommand(0xA4); // Display follows RAM, entire display ON (normal mode) +
  sendDisplayCommand(0xA6); // Normal display (not inverted) +
  sendDisplayCommand(0xAF); // Display ON +
}

// EEPROM functions for high score
int readHighScore() {
  int highScore;
  EEPROM.get(EEPROM_HIGHSCORE_ADDR, highScore);
  if (highScore < 0 || highScore > 9999) {
    highScore = 0;
    EEPROM.put(EEPROM_HIGHSCORE_ADDR, highScore);
  }
  return highScore;
}

void writeHighScore(int score) {
  EEPROM.put(EEPROM_HIGHSCORE_ADDR, score);
}

class Screen {
public:
  virtual void draw() = 0;
  virtual int update() = 0; // 0: no change, -1: redraw, 1: to menu, 2: to play, 3: to highscore
  virtual void reset() {}
};

