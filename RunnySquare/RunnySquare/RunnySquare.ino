  void draw() {
    clearBuffer();
    drawBitmap(splashScreenBitmap);
  }

  int update() {
    if (millis() - startTime >= 2000) {
      return 1;
    }
    return 0;
  }
};

class MenuScreen : public Screen {
private:
  int selectedOption = 0;  // 0: Play, 1: Highscore
  bool lastSwitchState = HIGH;
  bool lastSelectState = HIGH;
  unsigned long lastSwitchDebounceTime = 0;
  unsigned long lastSelectDebounceTime = 0;
  bool switchStateStable = HIGH;
  bool selectStateStable = HIGH;

public:
  MenuScreen() {
    pinMode(BUTTON_MAIN, INPUT);
    pinMode(BUTTON_OTHER, INPUT);
  }

  void draw() {
    clearBuffer();
    uint8_t menuX = 40;
    if (selectedOption == 0) {
      drawRect(menuX - 2, 18, 60, 12, 1);  // highlight background
      drawText(menuX, 20, "PLAY", 0);      // text in black
      drawText(menuX, 36, "HIGHSCORE", 1); 
    } else {
      drawText(menuX, 20, "PLAY", 1);       // unselected text white
      drawRect(menuX - 2, 34, 60, 12, 1);   // highlight background
      drawText(menuX, 36, "HIGHSCORE", 0); 
    }

    updateDisplay();
  }

  int update() {
    bool currentSwitch = digitalRead(BUTTON_OTHER);
    bool currentSelect = digitalRead(BUTTON_MAIN);
    int result = 0;

    // Debounce main button
    if (currentSwitch != switchStateStable) {
      lastSwitchDebounceTime = millis();
      switchStateStable = currentSwitch;
    }

    if (millis() - lastSwitchDebounceTime >= DEBOUNCE_DELAY) {
      if (lastSwitchState == HIGH && switchStateStable == LOW) {
        selectedOption = 1 - selectedOption;
        result = -1;
      }
      lastSwitchState = switchStateStable;
    }

    // Debounce other button
    if (currentSelect != selectStateStable) {
      lastSelectDebounceTime = millis();
      selectStateStable = currentSelect;
    }
    if (millis() - lastSelectDebounceTime >= DEBOUNCE_DELAY) {
      if (lastSelectState == HIGH && selectStateStable == LOW) {
        result = (selectedOption == 0) ? 2 : 3; // 2: Play, 3: HighScore
      }
      lastSelectState = selectStateStable;
    }

    return result;
  }
};

class PlayScreen : public Screen {
private: 
  bool buzzerOn = false;
  unsigned long buzzerStartTime = 0;

  int playerX = 54; // Start near center
  int playerY = 12;
  int playerSpeed = 1;
  int playerSize = 4; // 4x4 pixel square
  int direction = -1; // 0: right, 1: down, 2: left, 3: up
  int score = 0;
  int prevPlayerX;
  int prevPlayerY;
  unsigned long lastMoveTime = 0;
  const unsigned long moveInterval = 25; // Move every 100 ms
  bool lastSwitchState = HIGH;
  bool switchStateStable = HIGH;

  bool firstDraw = true;
  int prevScore = -1;

  unsigned long lastSwitchDebounceTime = 0;
  // Inner rectangle (centered, 40x20 pixels)
  const int startLineX = 54;
  const int borderSize = 5;
  const int innerRectX = 40;
  const int innerRectY = 20;
  const int innerRectWidth = 46;
  const int innerRectHeight = 22;
  const int topBorderX = 0;
  const int topBorderY = 0;
  const int topBorderWidth = SCREEN_WIDTH;
  const int topBorderHeight = borderSize;
  const int rightBorderX = SCREEN_WIDTH - borderSize;
  const int rightBorderY = 0;
  const int rightBorderWidth = borderSize;
  const int rightBorderHeight = SCREEN_HEIGHT;
  const int leftBorderX = 0;
  const int leftBorderY = 0;
  const int leftBorderWidth = borderSize;
  const int leftBorderHeight = SCREEN_HEIGHT;
  const int bottomBorderX = 0;
  const int bottomBorderY = SCREEN_HEIGHT - borderSize;
  const int bottomBorderWidth = SCREEN_WIDTH;
  const int bottomBorderHeight = borderSize;

  int scoreX = innerRectX + innerRectWidth/2 - 3;
  int scoreY = innerRectY + innerRectHeight/2 - 4;

public:
  PlayScreen() {
    pinMode(BUTTON_MAIN, INPUT);
    reset();
  }

  void reset() {
    buzzerOn = false;
    digitalWrite(BUZZER_PIN, LOW);
    firstDraw = true;
    prevScore = -1;
    playerX = 54;
    playerY = 12;
    direction = -1; 
    lastMoveTime = millis();
    lastSwitchState = HIGH;
    switchStateStable = HIGH;
    score = 0;
    prevPlayerX = playerX;
    prevPlayerY = playerY;
    lastSwitchDebounceTime = 0;
  }

  int getScore() {
    return score;
  }

  /*void draw() {
    clearBuffer();
    drawRect(innerRectX, innerRectY, innerRectWidth, innerRectHeight, 1);
    drawRect(topBorderX, topBorderY, topBorderWidth, topBorderHeight, 1);
    drawRect(rightBorderX, rightBorderY, rightBorderWidth, rightBorderHeight, 1);
    drawRect(leftBorderX, leftBorderY, leftBorderWidth, leftBorderHeight, 1);
    drawRect(bottomBorderX , bottomBorderY, bottomBorderWidth, bottomBorderHeight, 1);
    drawRect(playerX, playerY, playerSize, playerSize, 1);
    drawText(innerRectX + innerRectWidth/2 - 3, innerRectY + innerRectHeight/2 - 4, String(score).c_str(), 0);
    updateDisplay();
  }*/
  
  void draw() {
    if (firstDraw) {
      clearBuffer();
      drawRect(innerRectX, innerRectY, innerRectWidth, innerRectHeight, 1);
      drawRect(topBorderX, topBorderY, topBorderWidth, topBorderHeight, 1);
      drawRect(rightBorderX, rightBorderY, rightBorderWidth, rightBorderHeight, 1);
      drawRect(leftBorderX, leftBorderY, leftBorderWidth, leftBorderHeight, 1);
      drawRect(bottomBorderX , bottomBorderY, bottomBorderWidth, bottomBorderHeight, 1);
      //drawText(innerRectX + innerRectWidth/2 - 3, innerRectY + innerRectHeight/2 - 4, String(score).c_str(), 0);
      firstDraw = false;
    } else {
      // Erase old player
      drawRect(prevPlayerX, prevPlayerY, playerSize, playerSize, 0);
    }

    // Draw new player
    drawRect(playerX, playerY, playerSize, playerSize, 1);

    /*if (score != prevScore) {
      String s = String(score);
      uint8_t textWidth = s.length() * 6;
      //drawRect(scoreX, scoreY, 24, 8, 1);
      //drawText(scoreX, scoreY, s.c_str(), 0);
      //drawText(innerRectX + innerRectWidth/2 - 3, innerRectY + innerRectHeight/2 - 4, String(score).c_str(), 0);
      prevScore = score;
    }*/

     if (score != prevScore) {
      // Clear score area (max 4 digits, 4 * 6 = 24 pixels wide)
      uint8_t maxTextWidth = 24;
      drawRect(innerRectX + 1, scoreY, innerRectWidth - 2, 8, 1); // Clear full inner rect width (minus borders)
      // Center score dynamically
      String s = String(score);
      uint8_t textWidth = s.length() * 6; // 5 pixels/char + 1 spacing
      //uint8_t scoreX = innerRectX + (innerRectWidth - textWidth) / 2; // Center in inner rect
      drawText(scoreX, scoreY, s.c_str(), 0); // Draw black text
      prevScore = score;
    }

    updateDisplay();
  }

  int update() {
    // Handle button input
    bool currentSwitch = digitalRead(BUTTON_MAIN);
    if (currentSwitch != switchStateStable) {
      lastSwitchDebounceTime = millis();
      switchStateStable = currentSwitch;
    }
    if (millis() - lastSwitchDebounceTime >= DEBOUNCE_DELAY) {
      if (lastSwitchState == HIGH && switchStateStable == LOW) { // Button pressed
        direction = (direction + 1) % 4; // Change direction clockwise
        lastSwitchState = switchStateStable;
      }
      lastSwitchState = switchStateStable;
    }

    // Turn off buzzer after duration
    if (buzzerOn && millis() - buzzerStartTime >= SCORE_BEEP_DURATION) {
      digitalWrite(BUZZER_PIN, LOW);
      buzzerOn = false;
    }

    // Move player
    if (millis() - lastMoveTime >= moveInterval) {
      prevPlayerX = playerX;
      prevPlayerY = playerY;
      switch (direction) {
        case 0: playerX += playerSpeed; break; // Right
        case 1: playerY += playerSpeed; break; // Down
        case 2: playerX -= playerSpeed; break; // Left
        case 3: playerY -= playerSpeed; break; // Up
      }
      lastMoveTime = millis();

      // Score on right crossing of start line
      if (direction == 0 && prevPlayerX < startLineX && playerX >= startLineX) {
        score++;
        if (!buzzerOn) {
          digitalWrite(BUZZER_PIN, HIGH);
          buzzerOn = true;
          buzzerStartTime = millis();
        }
      }

      // Check collisions
      if (playerX < borderSize || playerX + playerSize > rightBorderX || playerY < borderSize || playerY + playerSize > bottomBorderY) {
        digitalWrite(BUZZER_PIN, LOW);
        buzzerOn = false;
        return 4; // Game over
      }
      // Inner rectangle (check if any player pixel overlaps)
      if (playerX + playerSize > innerRectX && playerX < innerRectX + innerRectWidth && playerY + playerSize > innerRectY && playerY < innerRectY + innerRectHeight) {
        digitalWrite(BUZZER_PIN, LOW);
        buzzerOn = false;
        return 4; // Game over
      }
      return -1; // Redraw screen
    }

    return 0;
  }
};

PlayScreen playScreen;

class GameOverScreen : public Screen {
private: 
  unsigned long startTime;
  int currentScore;

public: 
  GameOverScreen() {
    reset();
  }

  void reset() {
    startTime = millis();
    //Update high score
    currentScore = playScreen.getScore();
    int highScore = readHighScore();
    if (currentScore > highScore) {
      writeHighScore(currentScore);
    } 
  }

  void draw() {
    clearBuffer();
    drawText(30, 20, "GAME OVER!", 1);
    drawText(30, 40, "YOUR SCORE: ", 1);
    drawText(100, 40, String(currentScore).c_str(), 1);
    updateDisplay();
  }

  int update() {
    if (millis() - startTime >= 3000) {
      return 1; // Back to menu after 3 seconds
    }
    return 0;
  }
};

class HighscoreScreen : public Screen {
private: 
  bool lastSelectState = HIGH;
  bool selectStateStable = HIGH;
  unsigned long lastSelectDebounceTime = 0;
public: 
  HighscoreScreen() {
    pinMode(BUTTON_OTHER, INPUT);
  }
  void draw() {
    clearBuffer();
    drawText(30, 30, "HIGHSCORE: ", 1);
    int highScore = readHighScore();
    drawText(100, 30, String(highScore).c_str(), 1);
    updateDisplay();
  }

  int update() {
    bool currentSelect = digitalRead(BUTTON_OTHER);
    if (currentSelect != selectStateStable) {
      lastSelectDebounceTime = millis();
      selectStateStable = currentSelect;
    }
    if (millis() - lastSelectDebounceTime >= DEBOUNCE_DELAY) {
      if (lastSelectState == HIGH && selectStateStable == LOW) { // Select button pressed
        return 1; // Back to menu
      }
      lastSelectState = selectStateStable;
    }
    return 0;
  }
};

SplashScreen splashScreen;
MenuScreen menuScreen;
GameOverScreen gameOverScreen;
HighscoreScreen highscoreScreen;

ScreenState currentState = SPLASH;
Screen* currentScreen = &splashScreen;

void setup() {
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);
  Wire.begin();
  Wire.setClock(400000);
  initDisplay(); 
  currentScreen->draw();
}

void loop() {
  unsigned long loopStart = millis();
  int status = currentScreen->update();
  
  if (status == -1) {
    currentScreen->draw();  // Redraw current screen
  } else if (status > 0) {
    switch (status) {
      case 1:
      currentState = MENU;
      currentScreen = &menuScreen;
      break;
      case 2:
      currentState = PLAY;
      currentScreen = &playScreen;
      playScreen.reset();
      break;
      case 3:
      currentState = HIGHSCORE;
      currentScreen = &highscoreScreen;
      break;
      case 4:
      currentState = GAME_OVER;
      currentScreen = &gameOverScreen;
      gameOverScreen.reset();
      break;
      default:
      break;
    }
    currentScreen->draw();
  }
}

